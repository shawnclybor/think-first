{ "pluginConfigs": {
    "think-first": { "options": { "writes": "WebFetch", "retries": "WebFetch" } },
    "think-first@inline": { "options": { "writes": "WebFetch", "retries": "WebFetch" } } },
  "hooks": { "PreToolUse": [ { "matcher": "WebFetch", "hooks": [ { "type": "command",
    "command": "printf '%s' \"${THINK_FIRST_ACTIVE:-unset}\" > \"$HANDOFF_OUT\"" } ] } ] } }
